+    try argv.appendSlice(allocator, &.{
         "--system",
         args.packages_loc.string,
         // TODO is it truly needed? sorting JSON values works for now
@@ -216,6 +230,33 @@ pub fn build(
     if (args.additional.len > 0)
         events.info(@src(), "Additional args: {s}", .{args.additional});
 
+    if (is_0_17_or_later) {
+        const result_of_configure = try std.process.Child.run(.{
+            .allocator = allocator,
+            .argv = argv.items,
+            .cwd_dir = project_setup.root.dir,
+            .env_map = self.env_map,
+            .max_output_bytes = 1 * 1024 * 1024,
+        });
+        switch (result_of_configure.term) {
+            .Exited => |code| if (code != 0) return result_of_configure,
+            .Signal, .Stopped, .Unknown => return result_of_configure,
+        }
+        defer {
+            allocator.free(result_of_configure.stderr);
+            allocator.free(result_of_configure.stdout);
+        }
+
+        const configuration_path = std.mem.trim(u8, result_of_configure.stdout, &std.ascii.whitespace);
+        return try std.process.Child.run(.{
+            .allocator = allocator,
+            .argv = &.{ self.exe, "run", args.build_runner_path, "--", configuration_path },
+            .cwd_dir = project_setup.root.dir,
+            .env_map = self.env_map,
+            .max_output_bytes = 1 * 1024 * 1024,
+        });
+    }
+
     return try std.process.Child.run(.{
         .allocator = allocator,
         .argv = argv.items,
