@@ -195,6 +195,16 @@ pub fn build(
     },
     events: Logger,
 ) std.process.Child.RunError!std.process.Child.RunResult {
+    // Zig 0.17 removed "--build-runner": "build.zig" is run by separate
+    // "configurer" process instead. Let it serialize configuration,
+    // and pass it to our "build runner" which reads it and sends report.
+    const is_0_17_or_later: bool = switch (self.version.kind) {
+        .live => false, // "live.zig" is still synced with old build runner.
+        .release => self.version.sem_ver.order(
+            .{ .major = 0, .minor = 17, .patch = 0 },
+        ).compare(.gte),
+    };
+
     var argv: std.ArrayListUnmanaged([]const u8) = .empty;
     defer argv.deinit(allocator);
     try argv.appendSlice(allocator, &.{
@@ -202,8 +212,12 @@ pub fn build(
         "build",
         "--build-file",
         project_setup.build_zig.string,
-        "--build-runner",
-        args.build_runner_path,
+    });
+    if (is_0_17_or_later)
+        try argv.append(allocator, "--print-configuration-path")
